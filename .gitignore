# Forge itself (downloaded installer, ~400 MB) and simulation output (~2 GB)
# Forge itself is IN this repo on purpose: a clone should run without fetching anything, and
# Forge should only change when we choose to change it. Generated bits are still excluded.
/forge-installer-2.0.15/res/skins/Jarvis/
/forge-installer-2.0.15/forge.log
/forge-installer-2.0.15/*.log
/results/

# Build output: rebuilt from scripts/tools/*.java (see scripts/tools, agent-manifest.txt)
*.class
*.jar
# ...except Forge's own jars, which are the one thing a clone cannot rebuild. The *.jar rule
# above is for build output (evalcache-agent.jar); it was silently swallowing these two as
# well, so "Forge is committed here" was true of its res tree and not of the code. 85 MB, and
# without them a fresh clone or a downloaded zip stops at "Missing: ...jar".
!/forge-installer-2.0.15/forge-gui-desktop-2.0.15-jar-with-dependencies.jar
!/forge-installer-2.0.15/forge-gui-mobile-dev-2.0.15-jar-with-dependencies.jar
/scripts/tools/classes/

# Forge's runtime data: keep custom cards, decks, preferences and UI settings only
/forge-data/cache/
/forge-data/games/
/forge-data/quest/
/forge-data/gauntlet/
/forge-data/achievements/
/forge-data/*.log

# scratch: keep scripts, probes, the user's recorded games and reference data; the rest is temp
/scratch/*
!/scratch/*.ps1
!/scratch/probe/
/scratch/probe/*
!/scratch/probe/*.java
!/scratch/play-logs/
/scratch/play-logs/*
!/scratch/play-logs/game_*.log
!/scratch/edhrec-data/
!/scratch/upgrade-candidates.txt

# Logs and crash dumps in the root
/*.log
/2026-10-12-00.txt

# Copies of decks\*.dck that play.ps1 makes on every start (the originals in decks\ are the source)
/forge-data/decks/commander/

# Forge's network play logs
/forge-data/networklogs/

# ui3d build output and libGDX native unpack dir
/ui3d/classes/
/ui3d/natives/

# bug reports from the 3D window are kept
!/scratch/bug-reports/
/scratch/bug-reports/*
!/scratch/bug-reports/*.md

# A portable JDK fetched by scripts\setup.ps1 when the machine has none. Downloaded, not
# committed - 180 MB, and whichever build is current is fine.
/tools/jdk/

# Machine-local Forge runtime files. These are written by Forge on every run and every one of
# us has our own, so committing them means the next person's "git pull" ABORTS rather than
# overwrite the copy already sitting in their working tree - which is exactly what happened on
# 2026-10-28 ("other people who just update scripts cant pull properly now"). The line above
# saying preferences are kept means the ones we choose to share, not these.
/forge-data/preferences/editor.xml
/forge-data/preferences/deck.preferences
/forge-data/decks-archive/

# Bug reports written before reportDir() learned where it was running from; the real ones live
# in scratch/bug-reports.
/forge-installer-2.0.15/scratch/

# Python bytecode from the model scripts (ui3d\models\make-*.py)
__pycache__/
*.pyc
